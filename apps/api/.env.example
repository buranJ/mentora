# Local development only — replace these values before any non-local deployment.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=mentora-local-development-jwt-secret-key-2026-only
COLLAB_INTERNAL_KEY=mentora-local-collab-key-2026-only
# Mentora dev infrastructure uses 5433, keeping a host PostgreSQL on 5432 untouched.
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@localhost:5433/learnhouse
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@school.dev
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=MentoraDevOnly!2026
# LiveKit development server (`livekit/livekit-server:v1.13.5 --dev`).
# These public dev credentials are intentionally local-only; production values
# must be injected by the deployment environment and must never enter the web app.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
